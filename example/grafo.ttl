@prefix : <http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#> .
@prefix gr: <http://purl.org/goodrelations/v1#> .
@prefix ns: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rec: <https://w3id.org/rec#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sioc: <http://rdfs.org/sioc/ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix pronto: <https://raw.githubusercontent.com/fdioguardi/pronto/main/ontology/pronto.owl#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix schema: <https://schema.org/> .


dcterms:date a owl:DatatypeProperty ;
    rdfs:label "Date"@en ;
    dcterms:description "Date may be used to express temporal information at any level of granularity.  Recommended practice is to express the date, date/time, or period of time according to ISO 8601-1 [[ISO 8601-1](https://www.iso.org/iso-8601-date-and-time-format.html)] or a published profile of the ISO standard, such as the W3C Note on Date and Time Formats [[W3CDTF](https://www.w3.org/TR/NOTE-datetime)] or the Extended Date/Time Format Specification [[EDTF](http://www.loc.gov/standards/datetime/)].  If the full date is unknown, month and year (YYYY-MM) or just year (YYYY) may be used. Date ranges may be specified using ISO 8601 period of time specification in which start and end dates are separated by a '/' (slash) character.  Either the start or end date may be missing."@en ;
    rdfs:comment "A point or period of time associated with an event in the lifecycle of the resource."@en ;
    rdfs:domain pronto:RealEstateListing ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:range rdfs:Literal .

dcterms:description a owl:AnnotationProperty .

gr:hasCurrency a owl:DatatypeProperty ;
    rdfs:label "has currency (1..1)"@en ;
    rdfs:comment "The currency for all prices in the gr:PriceSpecification given using the ISO 4217 standard (3 characters)."@en ;
    rdfs:isDefinedBy <http://purl.org/goodrelations/v1> .

gr:hasCurrencyValue a owl:DatatypeProperty ;
    rdfs:label "has currency value (0..1)"@en ;
    rdfs:comment "This property specifies the amount of money for a price per unit, shipping charges, or payment charges. The currency and other relevant details are attached to the respective gr:PriceSpecification etc."@en ;
    rdfs:domain gr:PriceSpecification ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf owl:topDataProperty .

gr:hasUnitOfMeasurement a owl:DatatypeProperty ;
    rdfs:label "has unit of measurement (1..1)"@en ;
    rdfs:comment "The unit of measurement for a gr:QuantitativeValue, a gr:UnitPriceSpecification, or a gr:TypeAndQuantityNode given using the UN/CEFACT Common Code (3 characters)."@en ;
    rdfs:domain gr:QuantitativeValue ;
    rdfs:isDefinedBy <http://purl.org/goodrelations/v1> ;
    rdfs:range xsd:string .

gr:hasValue a owl:DatatypeProperty ;
    rdfs:label "has value (0..1)"@en ;
    rdfs:comment "This subproperty specifies that the upper and lower limit of the given gr:QuantitativeValue are identical and have the respective value. It is a shortcut for such cases where a quantitative property is (at least practically) a single point value and not an interval."@en ;
    rdfs:domain gr:QuantitativeValue ;
    rdfs:isDefinedBy <http://purl.org/goodrelations/v1> ;
    rdfs:range xsd:float ;
    rdfs:subPropertyOf owl:topDataProperty .

gr:priceType a owl:DatatypeProperty ;
    rdfs:label "price type (0..1)"@en ;
    rdfs:comment """This attribute can be used to distinguish multiple different price specifications for the same gr:Offering. It supersedes the former gr:isListPrice property. The following values are recommended:

The absence of this property marks the actual sales price.

SRP: "suggested retail price" - applicable for all sorts of a non-binding retail price recommendations, e.g. such published by the manufacturer or the distributor. This value replaces the former gr:isListPrice property.

INVOICE: The invoice price, mostly used in the car industry - this is the price a dealer pays to the manufacturer, excluding rebates and charges."""@en ;
    rdfs:domain gr:UnitPriceSpecification ;
    rdfs:isDefinedBy <http://purl.org/goodrelations/v1> ;
    rdfs:range xsd:string .

sioc:Forum a owl:Class ;
    rdfs:label "Forum"@en ;
    rdfs:comment "A discussion area on which Posts or entries are made."@en ;
    rdfs:isDefinedBy sioc: ;
    rdfs:subClassOf sioc:Container .

sioc:about a owl:ObjectProperty ;
    rdfs:label "about"@en ;
    rdfs:comment "Specifies that this Item is about a particular resource, e.g. a Post describing a real estate offer"@en ;
    rdfs:domain sioc:Item ;
    rdfs:isDefinedBy sioc: .

sioc:container_of a owl:ObjectProperty ;
    owl:inverseOf sioc:has_container .

sioc:creator_of a owl:ObjectProperty ;
    rdfs:label "creator of"@en ;
    rdfs:comment "A resource that the UserAccount is a creator of."@en ;
    rdfs:domain sioc:UserAccount ;
    rdfs:isDefinedBy sioc: ;
    rdfs:range sioc:Post ;
    owl:inverseOf sioc:has_creator .

sioc:has_host a owl:ObjectProperty ;
    rdfs:label "has host"@en ;
    rdfs:comment "The Site that hosts this Container."@en ;
    rdfs:domain sioc:Container ;
    rdfs:isDefinedBy sioc: ;
    rdfs:range sioc:Site ;
    rdfs:subPropertyOf sioc:has_space ;
    owl:inverseOf sioc:host_of .

sioc:id a owl:DatatypeProperty ;
    rdfs:label "id"@en ;
    rdfs:comment "An identifier of a SIOC concept instance. For example, a user ID. Must be unique for instances of each type of SIOC concept within the same site."@en ;
    rdfs:isDefinedBy sioc: ;
    rdfs:range rdfs:Literal .

sioc:name a owl:DatatypeProperty ;
    rdfs:label "name"@en ;
    rdfs:comment "The name of a SIOC concept instance, e.g. a username for a UserAccount, group name for a Usergroup, etc."@en ;
    rdfs:isDefinedBy sioc: ;
    rdfs:range rdfs:Literal .

sioc:read_at a owl:DatatypeProperty ;
    rdfs:range rdfs:Literal .

geo:asWKT a owl:DatatypeProperty ;
    rdfs:domain geo:Geometry ;
    rdfs:range geo:wktLiteral ;
    rdfs:subPropertyOf geo:hasSerialization .

geo:hasGeometry a owl:ObjectProperty ;
    rdfs:domain rec:Space ;
    rdfs:range geo:Geometry ;
    schema:description "A spatial representation for a given Feature."@en ;
    schema:name "has geometry"@en .

<http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology> a owl:Ontology .

:AVE a owl:Class ;
    rdfs:subClassOf :Origin .

:Apartment a owl:Class ;
    rdfs:label "Departamento"@es-ar ;
    rdfs:subClassOf rec:RealEstate .

:BasePrice a owl:Class ;
    rdfs:comment "The selling price of the property" ;
    rdfs:subClassOf :Price .

:Condominium a owl:Class ;
    rdfs:label "Lote PH"@es-ar ;
    rdfs:subClassOf rec:RealEstate .

:CornerLot a owl:Class ;
    rdfs:comment "It represents a corner lot" ;
    rdfs:subClassOf :RealEstateFeature .

:CoveredSurface a owl:Class ;
    rdfs:subClassOf :Surface .

:Curation a owl:Class ;
    rdfs:subClassOf :Origin .

:FOT a owl:Class ;
    rdfs:comment "Factor de Ocupación Total" ;
    rdfs:subClassOf :RealEstateFeature .

:FacadeOrientation a owl:Class ;
    rdfs:comment "It indicates the orientation of a building's facade" ;
    rdfs:subClassOf :RealEstateFeature .

:FacadesAmnt a owl:Class ;
    rdfs:comment "This represents the number of street-facing sides or entrances of a building" ;
    rdfs:subClassOf :RealEstateFeature .

:Farm a owl:Class ;
    rdfs:label "Campo"@es-ar ;
    rdfs:subClassOf rec:RealEstate .

:GatedNeighborhood a owl:Class ;
    rdfs:comment "Includes gated communities, country clubs, and ranches" ;
    rdfs:subClassOf :Neighborhood .

:Hotel a owl:Class ;
    rdfs:subClassOf rec:RealEstate .

:House a owl:Class ;
    rdfs:label "Casa"@es-ar ;
    rdfs:subClassOf rec:RealEstate .

:IrregularLot a owl:Class ;
    rdfs:comment "This indicates that the property has a non-rectangular lot" ;
    rdfs:subClassOf :RealEstateFeature .

:Land a owl:Class ;
    rdfs:label "Terreno"@es-ar ;
    rdfs:subClassOf rec:RealEstate .

:LandSurface a owl:Class ;
    rdfs:subClassOf :Surface .

:MaintenanceFee a owl:Class ;
    rdfs:comment "The property's maintenance fees" ;
    rdfs:subClassOf :Price .

:ParkingLot a owl:Class ;
    rdfs:label "Cochera"@es-ar ;
    rdfs:subClassOf rec:RealEstate .

:PopularNeighborhood a owl:Class ;
    rdfs:comment "These are working-class neighborhoods listed in the RENABAP" ;
    rdfs:subClassOf :Neighborhood .

:PreSale a owl:Class ;
    rdfs:subClassOf :RealEstateFeature .

:PropertyAge a owl:Class ;
    rdfs:comment "The age of a property. If it is 0, it is brand new" ;
    rdfs:subClassOf :RealEstateFeature .

:Scraper a owl:Class ;
    rdfs:subClassOf :Origin .

:Store a owl:Class ;
    rdfs:label "Local comercial"@es-ar ;
    rdfs:subClassOf rec:RealEstate .

:SwimmingPool a owl:Class ;
    rdfs:comment "Check if the property has its own pool" ;
    rdfs:subClassOf :RealEstateFeature .

:TotalSurface a owl:Class ;
    rdfs:subClassOf :Surface .

:UncoveredSurface a owl:Class ;
    rdfs:subClassOf :Surface .

:UndividedLot a owl:Class ;
    rdfs:comment "States that the land cannot be subdivided for sale" ;
    rdfs:subClassOf :RealEstateFeature .

:Warehouse a owl:Class ;
    rdfs:label "Galpón"@es-ar ;
    rdfs:subClassOf rec:RealEstate .

:city a owl:ObjectProperty ;
    rdfs:domain :PostalAddress ;
    rdfs:range :Municipality .

:curatedBy a owl:ObjectProperty ;
    rdfs:domain :Feature ;
    rdfs:subPropertyOf sioc:has_modifier .

:hasAddressValue a owl:ObjectProperty ;
    rdfs:domain :Address ;
    rdfs:range :PostalAddress ;
    rdfs:subPropertyOf :hasValue .

:hasDimensionsValue a owl:ObjectProperty ;
    rdfs:domain :LotDimensions ;
    rdfs:range pronto:SizeSpecification ;
    rdfs:subPropertyOf :hasValue .

:hasListingFeature a owl:ObjectProperty ;
    rdfs:domain pronto:RealEstateListing ;
    rdfs:range :ListingFeature ;
    rdfs:subPropertyOf :hasFeature .

:hasPriceValue a owl:ObjectProperty ;
    rdfs:domain :Price ;
    rdfs:range gr:PriceSpecification ;
    rdfs:subPropertyOf :hasValue .

:hasRealEstateFeature a owl:ObjectProperty ;
    rdfs:domain rec:RealEstate ;
    rdfs:range :RealEstateFeature ;
    rdfs:subPropertyOf :hasFeature .

:hasSurfaceValue a owl:ObjectProperty ;
    rdfs:domain :Surface ;
    rdfs:range pronto:SizeSpecification ;
    rdfs:subPropertyOf :hasValue .

:hasTime a owl:ObjectProperty ;
    rdfs:domain :Feature ;
    rdfs:subPropertyOf time:hasTime .

:neighborhood a owl:ObjectProperty ;
    rdfs:domain :PostalAddress ;
    rdfs:range :Neighborhood .

:province a owl:ObjectProperty ;
    rdfs:domain :PostalAddress ;
    rdfs:range :Province .

:reviewedBy a owl:ObjectProperty ;
    rdfs:domain :Feature ;
    rdfs:subPropertyOf sioc:has_modifier .

:town a owl:ObjectProperty ;
    rdfs:domain :PostalAddress ;
    rdfs:range :Town .

ns:term_status a owl:AnnotationProperty .

skos:definition a owl:AnnotationProperty .

skos:editorialNote a owl:AnnotationProperty .

skos:example a owl:AnnotationProperty .

skos:note a owl:AnnotationProperty .

time:inXSDDateTimeStamp a owl:DatatypeProperty ;
    rdfs:label "in XSD Date-Time-Stamp"@en,
        "en fecha-sello de tiempo XSD"@es ;
    rdfs:comment "Position of an instant, expressed using xsd:dateTimeStamp"@en,
        "Posición de un instante, expresado utilizando xsd:dateTimeStamp."@es ;
    rdfs:domain time:Instant ;
    rdfs:range xsd:dateTimeStamp ;
    skos:definition "Position of an instant, expressed using xsd:dateTimeStamp"@en,
        "Posición de un instante, expresado utilizando xsd:dateTimeStamp."@es .

brick:hasPart a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "Has part" ;
    rdfs:domain rec:Space ;
    rdfs:range rec:Space ;
    owl:inverseOf brick:isPartOf ;
    skos:definition "The subject is composed in part of the entity given by the object"@en .

schema:description a owl:AnnotationProperty .

schema:name a owl:AnnotationProperty .

rec:Bathroom a owl:Class ;
    rdfs:label "Bathroom" ;
    rdfs:subClassOf rec:Room .

rec:Bedroom a owl:Class ;
    rdfs:label "Bedroom" ;
    rdfs:subClassOf rec:Room .

rec:Building a owl:Class ;
    rdfs:label "Building" ;
    rdfs:comment "A confined building structure." ;
    rdfs:subClassOf rec:Architecture .

rec:OutdoorSpace a owl:Class ;
    rdfs:label "Outdoor space" ;
    rdfs:subClassOf rec:Architecture .

rec:Site a owl:Class ;
    rdfs:label "Site" ;
    rdfs:comment "A piece of land upon which zero or more buildings may be situated." ;
    rdfs:subClassOf rec:Architecture .

rec:includedIn a owl:ObjectProperty ;
    owl:inverseOf rec:includes .

rec:isLocationOf a owl:ObjectProperty ;
    owl:inverseOf rec:locatedIn .

dcterms:partOf a owl:ObjectProperty .

gr:Offering a owl:Class ;
    owl:disjointWith gr:PriceSpecification .

sioc:has_container a owl:ObjectProperty ;
    rdfs:label "has container"@en ;
    rdfs:comment "The Container to which this Item belongs."@en ;
    rdfs:domain sioc:Item ;
    rdfs:isDefinedBy sioc: ;
    rdfs:range sioc:Container ;
    rdfs:subPropertyOf dcterms:partOf .

sioc:has_creator a owl:ObjectProperty ;
    rdfs:domain sioc:Post ;
    rdfs:range sioc:UserAccount .

sioc:has_space a owl:ObjectProperty ;
    rdfs:range sioc:Space .

sioc:host_of a owl:ObjectProperty ;
    rdfs:label "host of"@en ;
    rdfs:comment "A Container that is hosted on this Site."@en ;
    rdfs:domain sioc:Site ;
    rdfs:isDefinedBy sioc: ;
    rdfs:range sioc:Container ;
    rdfs:subPropertyOf sioc:space_of .

sioc:modifier_of a owl:ObjectProperty ;
    rdfs:label "modifier of"@en ;
    rdfs:comment "A resource that this UserAccount has modified."@en ;
    rdfs:domain sioc:UserAccount ;
    rdfs:isDefinedBy sioc: ;
    rdfs:range :Feature .

sioc:space_of a owl:ObjectProperty .

geo:SpatialObject a owl:Class .

geo:hasSerialization a owl:DatatypeProperty .

geo:wktLiteral a rdfs:Datatype ;
    rdfs:isDefinedBy geo:,
        <http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/wkt-literal>,
        <http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/wkt-literal> ;
    rdfs:seeAlso <http://www.opengis.net/doc/IS/geosparql/1.1#c-1-2-4-%C2%A0-geometry-serializations> ;
    skos:example <http://www.opengis.net/doc/IS/geosparql/1.1#c-1-2-4-%C2%A0-geometry-serializations> ;
    schema:description "A Well-known Text serialization of a Geometry object."@en ;
    schema:name "Well-known Text Literal"@en .

:Address a owl:Class ;
    rdfs:comment "Represent the concept of having an address" ;
    rdfs:subClassOf :RealEstateFeature .

:LotDimensions a owl:Class ;
    rdfs:comment "The width and depth of the lot" ;
    rdfs:subClassOf :RealEstateFeature .

:Municipality a owl:Class ;
    rdfs:comment "Es un Partido de la Provincia" ;
    rdfs:subClassOf rec:Region .

:Province a owl:Class ;
    rdfs:subClassOf rec:Region .

:Town a owl:Class ;
    rdfs:comment "Es la subdivisión de una municipalidad (delegaciones)" ;
    rdfs:subClassOf rec:Region .

rdfs:Resource a owl:Class .

time:Interval a owl:Class ;
    rdfs:label "Time interval"@en,
        "intervalo de tiempo"@es ;
    rdfs:comment "A temporal entity with an extent or duration"@en,
        "Una entidad temporal con una extensión o duración."@es ;
    rdfs:subClassOf time:TemporalEntity ;
    skos:definition "A temporal entity with an extent or duration"@en,
        "Una entidad temporal con una extensión o duración."@es .

time:hasTime a owl:ObjectProperty ;
    rdfs:label "has time"@en ;
    rdfs:comment "Supports the association of a temporal entity (instant or interval) to any thing"@en ;
    rdfs:range time:TemporalEntity ;
    skos:definition "Supports the association of a temporal entity (instant or interval) to any thing"@en .

foaf:Document a owl:Class .

brick:isPartOf a owl:ObjectProperty .

rec:Collection a owl:Class .

rec:includes a owl:ObjectProperty ;
    rdfs:label "includes"@en ;
    rdfs:comment "Member entities of a collection; e.g., a Campus includes some Space, an Apartment includes some Room, etc."@en ;
    rdfs:domain rec:RealEstate ;
    rdfs:range rec:Architecture .

rec:locatedIn a owl:ObjectProperty ;
    rdfs:label "located in"@en ;
    rdfs:range rec:Space .

gr:UnitPriceSpecification a owl:Class ;
    rdfs:label "Unit price specification"@en ;
    rdfs:comment "A unit price specification is a conceptual entity that specifies the price asked for a given gr:Offering by the respective gr:Business Entity"@en ;
    rdfs:isDefinedBy <http://purl.org/goodrelations/v1> ;
    rdfs:subClassOf gr:PriceSpecification .

sioc:Site a owl:Class ;
    rdfs:comment "The webpage where the listing is published" ;
    rdfs:subClassOf sioc:Space .

sioc:has_modifier a owl:ObjectProperty ;
    rdfs:label "has modifier"@en ;
    rdfs:comment "A UserAccount that modified this resource (e.g. Item, Container, Space)."@en ;
    rdfs:isDefinedBy sioc: ;
    rdfs:range sioc:UserAccount ;
    owl:inverseOf sioc:modifier_of .

geo:Geometry a owl:Class ;
    rdfs:subClassOf geo:SpatialObject ;
    schema:description "A coherent set of direct positions in space. The positions are held within a Spatial Reference System (SRS)."@en ;
    schema:name "Geometry"@en .

:ListingFeature a owl:Class ;
    rdfs:subClassOf :Feature .

:hasFeature a owl:ObjectProperty ;
    rdfs:comment "Característica extraída a partir del web scraper" ;
    rdfs:range :Feature .

time:Instant a owl:Class ;
    rdfs:label "Time instant"@en,
        "instante de tiempo."@es ;
    rdfs:comment "A temporal entity with zero extent or duration"@en,
        "Una entidad temporal con una extensión o duración cero."@es ;
    rdfs:subClassOf time:TemporalEntity ;
    skos:definition "A temporal entity with zero extent or duration"@en,
        "Una entidad temporal con una extensión o duración cero."@es .

pronto:RealEstateListing a owl:Class ;
    rdfs:label "Real Estate Listing"@en ;
    rdfs:comment "A public advertisement of some real estate."@en ;
    rdfs:subClassOf gr:Offering,
        sioc:Post .

pronto:SizeSpecification a owl:Class ;
    rdfs:label "Size specification"@en ;
    rdfs:comment "A unit price specification is a conceptual entity that specifies the size of a given rec:Space. A space may be linked to multiple size specifications that specify alternative sizes for different types of measurements (e.g. total or covered surface)."@en ;
    rdfs:subClassOf gr:QuantitativeValue .

rec:Room a owl:Class ;
    rdfs:label "Room" ;
    rdfs:subClassOf rec:Architecture .

gr:QuantitativeValue a owl:Class .

sioc:Post a owl:Class ;
    rdfs:label "Post"@en ;
    rdfs:comment "An article or message that can be posted to a Forum."@en ;
    rdfs:isDefinedBy sioc: ;
    rdfs:subClassOf sioc:Item,
        foaf:Document .

sioc:Space a owl:Class .

:Neighborhood a owl:Class ;
    rdfs:subClassOf rec:Region .

:Price a owl:Class ;
    rdfs:subClassOf :ListingFeature .

time:TemporalEntity a owl:Class ;
    rdfs:label "Temporal entity"@en,
        "entidad temporal"@es ;
    rdfs:comment "A temporal interval or instant."@en,
        "Un intervalo temporal o un instante."@es ;
    rdfs:subClassOf owl:Thing ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( time:Instant time:Interval ) ] ;
    skos:definition "A temporal interval or instant."@en,
        "Un intervalo temporal o un instante."@es .

gr:PriceSpecification a owl:Class ;
    rdfs:label "Price specification"@en ;
    rdfs:comment "The superclass of all price specifications."@en ;
    rdfs:isDefinedBy <http://purl.org/goodrelations/v1> ;
    rdfs:subClassOf gr:UnitPriceSpecification .

sioc:Container a owl:Class ;
    owl:disjointWith sioc:Item .

sioc:Item a owl:Class ;
    rdfs:label "Item"@en ;
    rdfs:comment "An Item is something which can be in a Container."@en ;
    rdfs:isDefinedBy sioc: ;
    owl:disjointWith sioc:Space,
        sioc:UserAccount .

:Origin a owl:Class .

:hasValue a owl:DatatypeProperty,
        owl:ObjectProperty ;
    rdfs:domain :Feature ;
    rdfs:range rdfs:Literal .

rec:Region a owl:Class ;
    rdfs:subClassOf rec:Space .

sioc:UserAccount a owl:Class ;
    rdfs:comment "The real estate agent that publish a listing on a site" .

:PostalAddress a owl:Class ;
    rdfs:comment "Models the postal address" .

:Surface a owl:Class ;
    rdfs:subClassOf :RealEstateFeature .

rec:Architecture a owl:Class ;
    rdfs:label "Architecture" ;
    rdfs:comment "A designed/landscaped (or potentially designed/landscaped) part of the physical world that has a 3D spatial extent. E.g., a building site, a building, levels within the building, rooms, etc." ;
    rdfs:subClassOf rec:Space .

rec:Space a owl:Class ;
    rdfs:label "Space" ;
    rdfs:comment "A contiguous part of the physical world that contains or can contain sub-spaces. E.g., a Region can contain many Sites, which in turn can contain many Buildings." ;
    rdfs:subClassOf rdfs:Resource .

:Feature a owl:Class ;
    rdfs:label "Feature"@en ;
    rdfs:comment "The Feature class is used to model various aspects of a property, including a timestamp indicating when the value of that feature was recorded" .

rec:RealEstate a owl:Class ;
    rdfs:label "Real Estate" ;
    rdfs:comment "The legal/administrative representation of some lands and/or buildings. I.e., \"Fastighet\" (Swedish), \"Ejendom\" (Denmark), etc." ;
    rdfs:subClassOf rec:Collection .

:RealEstateFeature a owl:Class ;
    rdfs:comment "indicates whether the property is in the pre-sale phase" ;
    rdfs:subClassOf :Feature .

