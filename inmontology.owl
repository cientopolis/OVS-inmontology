        <rdfs:subClassOf rdf:resource="https://w3id.org/rec#RealEstate"/>
        <rdfs:label xml:lang="es-ar">Casa</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#IrregularLot -->

    <owl:Class rdf:about="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#IrregularLot">
