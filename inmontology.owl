    </owl:Class>
    


    <!-- http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#FOT -->

    <owl:Class rdf:about="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#FOT">
