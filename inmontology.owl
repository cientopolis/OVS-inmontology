        <rdfs:label xml:lang="es-ar">Campo</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#Feature -->

    <owl:Class rdf:about="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#Feature">
        <rdfs:comment>The Feature class is used to model various aspects of a property, including a timestamp indicating when the value of that feature was recorded</rdfs:comment>
        <rdfs:label xml:lang="en">Feature</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#GatedNeighborhood -->

    <owl:Class rdf:about="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#GatedNeighborhood">
