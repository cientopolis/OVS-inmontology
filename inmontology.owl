<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#"
     xml:base="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology"
     xmlns:dc="http://purl.org/dc/terms/"
     xmlns:gr="http://purl.org/goodrelations/v1#"
     xmlns:io="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology"
     xmlns:ns="http://www.w3.org/2003/06/sw-vocab-status/ns#"
     xmlns:geo="http://www.opengis.net/ont/geosparql#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rec="https://w3id.org/rec#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:sioc="http://rdfs.org/sioc/ns#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:time="http://www.w3.org/2006/time#"
     xmlns:brick="https://brickschema.org/schema/Brick#"
     xmlns:pronto="https://raw.githubusercontent.com/fdioguardi/pronto/main/ontology/pronto.owl#"
     xmlns:schema="https://schema.org/">
    <owl:Ontology rdf:about="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://www.w3.org/2003/06/sw-vocab-status/ns#term_status -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/06/sw-vocab-status/ns#term_status"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#editorialNote -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#editorialNote"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#example -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#example"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#note -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#note"/>
    


    <!-- https://schema.org/description -->

    <owl:AnnotationProperty rdf:about="https://schema.org/description"/>
    


    <!-- https://schema.org/name -->

    <owl:AnnotationProperty rdf:about="https://schema.org/name"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.opengis.net/ont/geosparql#wktLiteral -->

    <rdfs:Datatype rdf:about="http://www.opengis.net/ont/geosparql#wktLiteral">
        <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
        <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/wkt-literal"/>
        <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/wkt-literal"/>
        <rdfs:seeAlso rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#c-1-2-4-%C2%A0-geometry-serializations"/>
        <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#c-1-2-4-%C2%A0-geometry-serializations"/>
        <schema:description xml:lang="en">A Well-known Text serialization of a Geometry object.</schema:description>
        <schema:name xml:lang="en">Well-known Text Literal</schema:name>
    </rdfs:Datatype>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/partOf -->

    <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/partOf"/>
    


    <!-- http://rdfs.org/sioc/ns#about -->

    <owl:ObjectProperty rdf:about="http://rdfs.org/sioc/ns#about">
        <rdfs:domain rdf:resource="http://rdfs.org/sioc/ns#Item"/>
        <rdfs:comment xml:lang="en">Specifies that this Item is about a particular resource, e.g. a Post describing a real estate offer</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://rdfs.org/sioc/ns#"/>
        <rdfs:label xml:lang="en">about</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://rdfs.org/sioc/ns#container_of -->

    <owl:ObjectProperty rdf:about="http://rdfs.org/sioc/ns#container_of">
        <owl:inverseOf rdf:resource="http://rdfs.org/sioc/ns#has_container"/>
    </owl:ObjectProperty>
    


    <!-- http://rdfs.org/sioc/ns#creator_of -->

    <owl:ObjectProperty rdf:about="http://rdfs.org/sioc/ns#creator_of">
        <owl:inverseOf rdf:resource="http://rdfs.org/sioc/ns#has_creator"/>
        <rdfs:domain rdf:resource="http://rdfs.org/sioc/ns#UserAccount"/>
        <rdfs:range rdf:resource="http://rdfs.org/sioc/ns#Post"/>
        <rdfs:comment xml:lang="en">A resource that the UserAccount is a creator of.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://rdfs.org/sioc/ns#"/>
        <rdfs:label xml:lang="en">creator of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://rdfs.org/sioc/ns#has_container -->

    <owl:ObjectProperty rdf:about="http://rdfs.org/sioc/ns#has_container">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/partOf"/>
        <rdfs:domain rdf:resource="http://rdfs.org/sioc/ns#Item"/>
        <rdfs:range rdf:resource="http://rdfs.org/sioc/ns#Container"/>
        <rdfs:comment xml:lang="en">The Container to which this Item belongs.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://rdfs.org/sioc/ns#"/>
        <rdfs:label xml:lang="en">has container</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://rdfs.org/sioc/ns#has_creator -->

    <owl:ObjectProperty rdf:about="http://rdfs.org/sioc/ns#has_creator">
        <rdfs:domain rdf:resource="http://rdfs.org/sioc/ns#Post"/>
        <rdfs:range rdf:resource="http://rdfs.org/sioc/ns#UserAccount"/>
    </owl:ObjectProperty>
    


    <!-- http://rdfs.org/sioc/ns#has_host -->

    <owl:ObjectProperty rdf:about="http://rdfs.org/sioc/ns#has_host">
        <rdfs:subPropertyOf rdf:resource="http://rdfs.org/sioc/ns#has_space"/>
        <owl:inverseOf rdf:resource="http://rdfs.org/sioc/ns#host_of"/>
        <rdfs:domain rdf:resource="http://rdfs.org/sioc/ns#Container"/>
        <rdfs:range rdf:resource="http://rdfs.org/sioc/ns#Site"/>
        <rdfs:comment xml:lang="en">The Site that hosts this Container.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://rdfs.org/sioc/ns#"/>
        <rdfs:label xml:lang="en">has host</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://rdfs.org/sioc/ns#has_modifier -->

    <owl:ObjectProperty rdf:about="http://rdfs.org/sioc/ns#has_modifier">
        <owl:inverseOf rdf:resource="http://rdfs.org/sioc/ns#modifier_of"/>
        <rdfs:range rdf:resource="http://rdfs.org/sioc/ns#UserAccount"/>
        <rdfs:comment xml:lang="en">A UserAccount that modified this resource (e.g. Item, Container, Space).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://rdfs.org/sioc/ns#"/>
        <rdfs:label xml:lang="en">has modifier</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://rdfs.org/sioc/ns#has_space -->

    <owl:ObjectProperty rdf:about="http://rdfs.org/sioc/ns#has_space">
        <rdfs:range rdf:resource="http://rdfs.org/sioc/ns#Space"/>
    </owl:ObjectProperty>
    


    <!-- http://rdfs.org/sioc/ns#host_of -->

    <owl:ObjectProperty rdf:about="http://rdfs.org/sioc/ns#host_of">
        <rdfs:subPropertyOf rdf:resource="http://rdfs.org/sioc/ns#space_of"/>
        <rdfs:domain rdf:resource="http://rdfs.org/sioc/ns#Site"/>
        <rdfs:range rdf:resource="http://rdfs.org/sioc/ns#Container"/>
        <rdfs:comment xml:lang="en">A Container that is hosted on this Site.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://rdfs.org/sioc/ns#"/>
        <rdfs:label xml:lang="en">host of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://rdfs.org/sioc/ns#modifier_of -->

    <owl:ObjectProperty rdf:about="http://rdfs.org/sioc/ns#modifier_of">
        <rdfs:domain rdf:resource="http://rdfs.org/sioc/ns#UserAccount"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#Feature"/>
        <rdfs:comment xml:lang="en">A resource that this UserAccount has modified.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://rdfs.org/sioc/ns#"/>
        <rdfs:label xml:lang="en">modifier of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://rdfs.org/sioc/ns#space_of -->

    <owl:ObjectProperty rdf:about="http://rdfs.org/sioc/ns#space_of"/>
    


    <!-- http://www.opengis.net/ont/geosparql#hasGeometry -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#hasGeometry">
        <rdfs:domain rdf:resource="https://w3id.org/rec#Space"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
        <schema:description xml:lang="en">A spatial representation for a given Feature.</schema:description>
        <schema:name xml:lang="en">has geometry</schema:name>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#city -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#city">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#PostalAddress"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#Municipality"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#curatedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#curatedBy">
        <rdfs:subPropertyOf rdf:resource="http://rdfs.org/sioc/ns#has_modifier"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#Feature"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#hasAddressValue -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#hasAddressValue">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#hasValue"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#Address"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#PostalAddress"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#hasDimensionsValue -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#hasDimensionsValue">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#hasValue"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#LotDimensions"/>
        <rdfs:range rdf:resource="https://raw.githubusercontent.com/fdioguardi/pronto/main/ontology/pronto.owl#SizeSpecification"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#hasFeature -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#hasFeature">
        <rdfs:range rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#Feature"/>
        <rdfs:comment>Característica extraída a partir del web scraper</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#hasListingFeature -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#hasListingFeature">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#hasFeature"/>
        <rdfs:domain rdf:resource="https://raw.githubusercontent.com/fdioguardi/pronto/main/ontology/pronto.owl#RealEstateListing"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#ListingFeature"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#hasOrigin -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#hasOrigin">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#Feature"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#Origin"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#hasPriceValue -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#hasPriceValue">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#hasValue"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#Price"/>
        <rdfs:range rdf:resource="http://purl.org/goodrelations/v1#PriceSpecification"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#hasRealEstateFeature -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#hasRealEstateFeature">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#hasFeature"/>
        <rdfs:domain rdf:resource="https://w3id.org/rec#RealEstate"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#RealEstateFeature"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#hasSurfaceValue -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#hasSurfaceValue">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#hasValue"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#Surface"/>
        <rdfs:range rdf:resource="https://raw.githubusercontent.com/fdioguardi/pronto/main/ontology/pronto.owl#SizeSpecification"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#hasTime -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#hasTime">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2006/time#hasTime"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#Feature"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#hasValue -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#hasValue">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#Feature"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#locatedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#locatedIn">
        <rdfs:domain rdf:resource="https://w3id.org/rec#Region"/>
        <rdfs:range rdf:resource="https://w3id.org/rec#Region"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#neighborhood -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#neighborhood">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#PostalAddress"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#Neighborhood"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#province -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#province">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#PostalAddress"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#Province"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#reviewedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#reviewedBy">
        <rdfs:subPropertyOf rdf:resource="http://rdfs.org/sioc/ns#has_modifier"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#Feature"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#town -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#town">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#PostalAddress"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#Town"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2006/time#hasTime -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2006/time#hasTime">
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <rdfs:comment xml:lang="en">Supports the association of a temporal entity (instant or interval) to any thing</rdfs:comment>
        <rdfs:label xml:lang="en">has time</rdfs:label>
        <skos:definition xml:lang="en">Supports the association of a temporal entity (instant or interval) to any thing</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://brickschema.org/schema/Brick#hasPart -->

    <owl:ObjectProperty rdf:about="https://brickschema.org/schema/Brick#hasPart">
        <owl:inverseOf rdf:resource="https://brickschema.org/schema/Brick#isPartOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/rec#Space"/>
        <rdfs:range rdf:resource="https://w3id.org/rec#Space"/>
        <rdfs:label>Has part</rdfs:label>
        <skos:definition xml:lang="en">The subject is composed in part of the entity given by the object</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://brickschema.org/schema/Brick#isPartOf -->

    <owl:ObjectProperty rdf:about="https://brickschema.org/schema/Brick#isPartOf"/>
    


    <!-- https://w3id.org/rec#includedIn -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rec#includedIn">
        <owl:inverseOf rdf:resource="https://w3id.org/rec#includes"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rec#includes -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rec#includes">
        <rdfs:domain rdf:resource="https://w3id.org/rec#RealEstate"/>
        <rdfs:range rdf:resource="https://w3id.org/rec#Architecture"/>
        <rdfs:comment xml:lang="en">Member entities of a collection; e.g., a Campus includes some Space, an Apartment includes some Room, etc.</rdfs:comment>
        <rdfs:label xml:lang="en">includes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rec#isLocationOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/rec#isLocationOf"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/date -->

    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/date">
        <rdfs:domain rdf:resource="https://raw.githubusercontent.com/fdioguardi/pronto/main/ontology/pronto.owl#RealEstateListing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <dc:description xml:lang="en">Date may be used to express temporal information at any level of granularity.  Recommended practice is to express the date, date/time, or period of time according to ISO 8601-1 [[ISO 8601-1](https://www.iso.org/iso-8601-date-and-time-format.html)] or a published profile of the ISO standard, such as the W3C Note on Date and Time Formats [[W3CDTF](https://www.w3.org/TR/NOTE-datetime)] or the Extended Date/Time Format Specification [[EDTF](http://www.loc.gov/standards/datetime/)].  If the full date is unknown, month and year (YYYY-MM) or just year (YYYY) may be used. Date ranges may be specified using ISO 8601 period of time specification in which start and end dates are separated by a &apos;/&apos; (slash) character.  Either the start or end date may be missing.</dc:description>
        <rdfs:comment xml:lang="en">A point or period of time associated with an event in the lifecycle of the resource.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/dc/terms/"/>
        <rdfs:label xml:lang="en">Date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/goodrelations/v1#hasCurrency -->

    <owl:DatatypeProperty rdf:about="http://purl.org/goodrelations/v1#hasCurrency">
        <rdfs:comment xml:lang="en">The currency for all prices in the gr:PriceSpecification given using the ISO 4217 standard (3 characters).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/goodrelations/v1"/>
        <rdfs:label xml:lang="en">has currency (1..1)</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/goodrelations/v1#hasCurrencyValue -->

    <owl:DatatypeProperty rdf:about="http://purl.org/goodrelations/v1#hasCurrencyValue">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://purl.org/goodrelations/v1#PriceSpecification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">This property specifies the amount of money for a price per unit, shipping charges, or payment charges. The currency and other relevant details are attached to the respective gr:PriceSpecification etc.</rdfs:comment>
        <rdfs:label xml:lang="en">has currency value (0..1)</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/goodrelations/v1#hasUnitOfMeasurement -->

    <owl:DatatypeProperty rdf:about="http://purl.org/goodrelations/v1#hasUnitOfMeasurement">
        <rdfs:domain rdf:resource="http://purl.org/goodrelations/v1#QuantitativeValue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The unit of measurement for a gr:QuantitativeValue, a gr:UnitPriceSpecification, or a gr:TypeAndQuantityNode given using the UN/CEFACT Common Code (3 characters).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/goodrelations/v1"/>
        <rdfs:label xml:lang="en">has unit of measurement (1..1)</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/goodrelations/v1#hasValue -->

    <owl:DatatypeProperty rdf:about="http://purl.org/goodrelations/v1#hasValue">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://purl.org/goodrelations/v1#QuantitativeValue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="en">This subproperty specifies that the upper and lower limit of the given gr:QuantitativeValue are identical and have the respective value. It is a shortcut for such cases where a quantitative property is (at least practically) a single point value and not an interval.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/goodrelations/v1"/>
        <rdfs:label xml:lang="en">has value (0..1)</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/goodrelations/v1#priceType -->

    <owl:DatatypeProperty rdf:about="http://purl.org/goodrelations/v1#priceType">
        <rdfs:domain rdf:resource="http://purl.org/goodrelations/v1#UnitPriceSpecification"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">This attribute can be used to distinguish multiple different price specifications for the same gr:Offering. It supersedes the former gr:isListPrice property. The following values are recommended:

The absence of this property marks the actual sales price.

SRP: &quot;suggested retail price&quot; - applicable for all sorts of a non-binding retail price recommendations, e.g. such published by the manufacturer or the distributor. This value replaces the former gr:isListPrice property.

INVOICE: The invoice price, mostly used in the car industry - this is the price a dealer pays to the manufacturer, excluding rebates and charges.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/goodrelations/v1"/>
        <rdfs:label xml:lang="en">price type (0..1)</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://rdfs.org/sioc/ns#id -->

    <owl:DatatypeProperty rdf:about="http://rdfs.org/sioc/ns#id">
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="en">An identifier of a SIOC concept instance. For example, a user ID. Must be unique for instances of each type of SIOC concept within the same site.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://rdfs.org/sioc/ns#"/>
        <rdfs:label xml:lang="en">id</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://rdfs.org/sioc/ns#name -->

    <owl:DatatypeProperty rdf:about="http://rdfs.org/sioc/ns#name">
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="en">The name of a SIOC concept instance, e.g. a username for a UserAccount, group name for a Usergroup, etc.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://rdfs.org/sioc/ns#"/>
        <rdfs:label xml:lang="en">name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://rdfs.org/sioc/ns#read_at -->

    <owl:DatatypeProperty rdf:about="http://rdfs.org/sioc/ns#read_at">
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.opengis.net/ont/geosparql#asWKT -->

    <owl:DatatypeProperty rdf:about="http://www.opengis.net/ont/geosparql#asWKT">
        <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#hasSerialization"/>
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#wktLiteral"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.opengis.net/ont/geosparql#hasSerialization -->

    <owl:DatatypeProperty rdf:about="http://www.opengis.net/ont/geosparql#hasSerialization"/>
    


    <!-- http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#hasValue -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#hasValue">
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/2006/time#inXSDDateTimeStamp -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/2006/time#inXSDDateTimeStamp">
        <rdfs:domain rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <rdfs:comment xml:lang="es">Posición de un instante, expresado utilizando xsd:dateTimeStamp.</rdfs:comment>
        <rdfs:comment xml:lang="en">Position of an instant, expressed using xsd:dateTimeStamp</rdfs:comment>
        <rdfs:label xml:lang="es">en fecha-sello de tiempo XSD</rdfs:label>
        <rdfs:label xml:lang="en">in XSD Date-Time-Stamp</rdfs:label>
        <skos:definition xml:lang="es">Posición de un instante, expresado utilizando xsd:dateTimeStamp.</skos:definition>
        <skos:definition xml:lang="en">Position of an instant, expressed using xsd:dateTimeStamp</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://raw.githubusercontent.com/fdioguardi/pronto/main/ontology/pronto.owl#has_number_of_rooms -->

    <owl:DatatypeProperty rdf:about="https://raw.githubusercontent.com/fdioguardi/pronto/main/ontology/pronto.owl#has_number_of_rooms"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/goodrelations/v1#Offering -->

    <owl:Class rdf:about="http://purl.org/goodrelations/v1#Offering">
        <owl:disjointWith rdf:resource="http://purl.org/goodrelations/v1#PriceSpecification"/>
    </owl:Class>
    


    <!-- http://purl.org/goodrelations/v1#PriceSpecification -->

    <owl:Class rdf:about="http://purl.org/goodrelations/v1#PriceSpecification">
        <rdfs:subClassOf rdf:resource="http://purl.org/goodrelations/v1#UnitPriceSpecification"/>
        <rdfs:comment xml:lang="en">The superclass of all price specifications.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/goodrelations/v1"/>
        <rdfs:label xml:lang="en">Price specification</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/goodrelations/v1#QuantitativeValue -->

    <owl:Class rdf:about="http://purl.org/goodrelations/v1#QuantitativeValue"/>
    


    <!-- http://purl.org/goodrelations/v1#UnitPriceSpecification -->

    <owl:Class rdf:about="http://purl.org/goodrelations/v1#UnitPriceSpecification">
        <rdfs:subClassOf rdf:resource="http://purl.org/goodrelations/v1#PriceSpecification"/>
        <rdfs:comment xml:lang="en">A unit price specification is a conceptual entity that specifies the price asked for a given gr:Offering by the respective gr:Business Entity</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.org/goodrelations/v1"/>
        <rdfs:label xml:lang="en">Unit price specification</rdfs:label>
    </owl:Class>
    


    <!-- http://rdfs.org/sioc/ns#Container -->

    <owl:Class rdf:about="http://rdfs.org/sioc/ns#Container">
        <owl:disjointWith rdf:resource="http://rdfs.org/sioc/ns#Item"/>
    </owl:Class>
    


    <!-- http://rdfs.org/sioc/ns#Forum -->

    <owl:Class rdf:about="http://rdfs.org/sioc/ns#Forum">
        <rdfs:subClassOf rdf:resource="http://rdfs.org/sioc/ns#Container"/>
        <rdfs:comment xml:lang="en">A discussion area on which Posts or entries are made.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://rdfs.org/sioc/ns#"/>
        <rdfs:label xml:lang="en">Forum</rdfs:label>
    </owl:Class>
    


    <!-- http://rdfs.org/sioc/ns#Item -->

    <owl:Class rdf:about="http://rdfs.org/sioc/ns#Item">
        <owl:disjointWith rdf:resource="http://rdfs.org/sioc/ns#Space"/>
        <owl:disjointWith rdf:resource="http://rdfs.org/sioc/ns#UserAccount"/>
        <rdfs:comment xml:lang="en">An Item is something which can be in a Container.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://rdfs.org/sioc/ns#"/>
        <rdfs:label xml:lang="en">Item</rdfs:label>
    </owl:Class>
    


    <!-- http://rdfs.org/sioc/ns#Post -->

    <owl:Class rdf:about="http://rdfs.org/sioc/ns#Post">
        <rdfs:subClassOf rdf:resource="http://rdfs.org/sioc/ns#Item"/>
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <rdfs:comment xml:lang="en">An article or message that can be posted to a Forum.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://rdfs.org/sioc/ns#"/>
        <rdfs:label xml:lang="en">Post</rdfs:label>
    </owl:Class>
    


    <!-- http://rdfs.org/sioc/ns#Site -->

    <owl:Class rdf:about="http://rdfs.org/sioc/ns#Site">
        <rdfs:subClassOf rdf:resource="http://rdfs.org/sioc/ns#Space"/>
        <rdfs:comment>The webpage where the listing is published</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdfs.org/sioc/ns#Space -->

    <owl:Class rdf:about="http://rdfs.org/sioc/ns#Space"/>
    


    <!-- http://rdfs.org/sioc/ns#UserAccount -->

    <owl:Class rdf:about="http://rdfs.org/sioc/ns#UserAccount">
        <rdfs:comment>The real estate agent that publish a listing on a site</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.opengis.net/ont/geosparql#Geometry -->

    <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#Geometry">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <schema:description xml:lang="en">A coherent set of direct positions in space. The positions are held within a Spatial Reference System (SRS).</schema:description>
        <schema:name xml:lang="en">Geometry</schema:name>
    </owl:Class>
    


    <!-- http://www.opengis.net/ont/geosparql#SpatialObject -->

    <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    


