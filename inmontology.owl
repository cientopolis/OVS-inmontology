        <rdfs:subClassOf rdf:resource="https://w3id.org/rec#Space"/>
        <rdfs:comment>A designed/landscaped (or potentially designed/landscaped) part of the physical world that has a 3D spatial extent. E.g., a building site, a building, levels within the building, rooms, etc.</rdfs:comment>
        <rdfs:label>Architecture</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rec#Bathroom -->

