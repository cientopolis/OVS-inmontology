    </owl:Class>
    


    <!-- http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#PopularNeighborhood -->

    <owl:Class rdf:about="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#PopularNeighborhood">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#Neighborhood"/>
