    </owl:Class>
    


    <!-- http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#PostalAddress -->

    <owl:Class rdf:about="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#PostalAddress">
        <rdfs:comment>Models the postal address</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#PreSale -->

    <owl:Class rdf:about="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#PreSale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#RealEstateFeature"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#Price -->

    <owl:Class rdf:about="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#Price">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#ListingFeature"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#PropertyAge -->

    <owl:Class rdf:about="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#PropertyAge">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#RealEstateFeature"/>
