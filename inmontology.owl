        <rdfs:comment>Es un Partido de la Provincia</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#Neighborhood -->

    <owl:Class rdf:about="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#Neighborhood">
        <rdfs:subClassOf rdf:resource="https://w3id.org/rec#Region"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#Origin -->

    <owl:Class rdf:about="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#Origin"/>
    


    <!-- http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#ParkingLot -->

    <owl:Class rdf:about="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#ParkingLot">
