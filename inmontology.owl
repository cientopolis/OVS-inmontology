    <!-- http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#FacadeOrientation -->

    <owl:Class rdf:about="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#FacadeOrientation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/luciana/ontologies/2024/8/inmontology#RealEstateFeature"/>
